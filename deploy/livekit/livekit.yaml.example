port: 7880
bind_addresses:
  - ""

rtc:
  tcp_port: 7881
  # Весь WebRTC-медиатрафик через один UDP-порт (должен совпадать с docker-compose.yml)
  udp_port: 7882
  use_external_ip: true

redis:
  address: redis:6379

# Ключи API здесь не задаются: docker-compose передаёт их из livekit.env
# через переменную LIVEKIT_KEYS (LIVEKIT_API_KEY / LIVEKIT_API_SECRET).

# Встроенный TURN LiveKit требует TLS-сертификатов; по умолчанию используется внешний coturn.
turn:
  enabled: false
  domain: livekit.example.com
  cert_file: /certs/fullchain.pem
  key_file: /certs/privkey.pem

logging:
  level: info
